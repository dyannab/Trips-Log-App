@model Trips_Log_App.Models.TripAccommodation





<form asp-action="AddInfo" method="post">
    <div class="form-group">
        <label asp-for="AccommodationPhoneNumber">Phone Number</label>
        <input asp-for="AccommodationPhoneNumber" class="form-control" />
        <span asp-validation-for="AccommodationPhoneNumber" class="form-control"></span>
    </div>

    <div class="form-group">
        <label asp-for="AccommodationEmail"> Email Address</label>
        <input asp-for="AccommodationEmail" class="form-control" />
        <span asp-validation-for="AccommodationEmail" class="form-control"></span>
    </div>

    <button type="submit" class="btn btn-primary">Next</button>
    <a asp-controller="Home" asp-action="Index" class="btn btn-secondary">Cancel</a>
</form>

